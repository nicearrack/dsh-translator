{
  "name": "@nicearrack/dsh-translator",
  "version": "0.3.0",
  "description": "Youdao-style word-selection translation for the DSH web GUI. Select text anywhere, click the floating button, get a translation from the harness's own LLM — no API keys, no third-party endpoints. 有道风格划词翻译：DSH Web GUI 里划选文本即现悬浮翻译按钮，点击由 harness 自带大模型翻译，无需 API key、不依赖第三方接口。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "prepare": "node scripts/build.js",
    "test": "node --test \"tests/*.test.mjs\"",
    "test:host": "node scripts/host-sim.mjs",
    "check": "node --check src/index.js && node -e \"const fs=require('fs');new Function(fs.readFileSync('client/core.js','utf8'));console.log('syntax OK')\""
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "deepseek-harness-plugin",
    "cordis",
    "plugin",
    "translation",
    "word-selection",
    "word-selection-translation",
    "划词翻译"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.1-alpha.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nicearrack/dsh-translator.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "~3.18.5-alpha.1"
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "~3.18.5-alpha.1"
  },
  "dependencies": {
    "@deepseek-ai/cosmokit": "~1.8.6-alpha.1"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  }
}
